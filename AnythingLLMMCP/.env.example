# AnythingLLM instance base URL (no /api suffix)
ANYTHINGLLM_BASE_URL=http://localhost:3001

# AnythingLLM API key (Settings -> Tools -> API Keys, or Admin -> API Keys)
ANYTHINGLLM_API_KEY=your-anythingllm-api-key

# The single workspace this server answers from.
# Find it with: GET /api/v1/workspaces
ANYTHINGLLM_WORKSPACE_SLUG=your-workspace-slug

# Optional request timeout in seconds (default: 60)
ANYTHINGLLM_TIMEOUT=60
